FROM node:22-alpine AS builder

WORKDIR /app

# Copy root, server, and worker manifests
COPY package*.json ./
COPY server/package*.json ./server/
COPY worker/package*.json ./worker/

# Install dependencies for both server and worker (worker shares server models/queues)
RUN npm ci --prefix server && npm ci --prefix worker

# Copy source trees
COPY server/ ./server/
COPY worker/ ./worker/

# Build TypeScript to dist
RUN npm --prefix worker run build

# Prune devDependencies to keep image lean
RUN npm prune --prefix server --omit=dev && npm prune --prefix worker --omit=dev

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV WORKER_HEALTH_PORT=5001

# Copy production manifests, node_modules, and dist with non-root ownership
COPY --chown=node:node --from=builder /app/package*.json ./
COPY --chown=node:node --from=builder /app/server/package*.json ./server/
COPY --chown=node:node --from=builder /app/worker/package*.json ./worker/
COPY --chown=node:node --from=builder /app/server/node_modules ./server/node_modules
COPY --chown=node:node --from=builder /app/worker/node_modules ./worker/node_modules
COPY --chown=node:node --from=builder /app/worker/dist ./worker/dist

USER node

WORKDIR /app/worker

EXPOSE 5001

CMD ["node", "dist/worker/src/worker.js"]
