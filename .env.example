# LeadFlow Environment Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/leadflow

# Authentication & JWT Secrets (Replace with cryptographically secure strings in production)
JWT_SECRET=leadflow-jwt-super-secret-access-token-key-min32chars!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=leadflow-jwt-super-secret-refresh-token-key-min32chars!
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=leadflow-secure-cookie-secret-key-development

# CORS & Client URL
CORS_ORIGIN=http://localhost:5173

# External Webhook / Tunnel Configuration (e.g. ngrok or production domain)
WEBHOOK_BASE_URL=https://your-public-tunnel-or-domain.ngrok-free.dev
LEADFLOW_WEBHOOK_SECRET=your_demo_brokerage_webhook_secret

# ImageKit Storage Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Redis & BullMQ Configuration
# Use REDIS_HOST/PORT or a full REDIS_URL (e.g. for Upstash / Redis Cloud: rediss://default:token@host:port)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=rediss://default:password@your-redis-provider.com:6379
DOCUMENT_PROCESSING_CONCURRENCY=5
DOCUMENT_PROCESSING_DELAY_MS=2000
PENDING_DOCUMENT_RECOVERY_THRESHOLD_MS=15000
STALLED_DOCUMENT_RECOVERY_THRESHOLD_MS=300000
RECONCILIATION_INTERVAL_MS=60000

# Email Delivery Configuration (Resend)
# Use 'mock' for local development/testing without sending real emails, or 'resend' for production
EMAIL_PROVIDER=mock
# RESEND_API_KEY=re_1234567890abcdef12345678
# RESEND_WEBHOOK_SIGNING_SECRET=replace-with-your-resend-webhook-secret
EMAIL_FROM_ADDRESS=notifications@leadflow.io
EMAIL_FROM_NAME=LeadFlow Notifications
# EMAIL_REPLY_TO=support@leadflow.io


# MongoDB connection pool
MONGODB_MAX_POOL_SIZE=10

# Worker topology
# true = API process also runs BullMQ workers
# false = use a separate dedicated worker service
ENABLE_IN_PROCESS_WORKERS=true